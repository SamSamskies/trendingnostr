# Server-only. Never prefix with VITE_ (that would ship the key to the browser).
# Copy to `.env.local` for local `npx vercel dev` / `npm run dev:vercel`.
# Production: set the same vars in the Vercel project env.
#
# Current hosted provider is Google Gemini. Put the AI Studio key here.
# Swap the implementation in api/inference.ts to change providers without
# renaming the endpoint or these variable names.
INFERENCE_API_KEY=

# Optional. Defaults to gemma-4-31b-it.
# INFERENCE_MODEL=gemma-4-31b-it

# Kill switch without redeploying the client (false/0/off disables /api/inference).
# INFERENCE_FALLBACK_ENABLED=true

# Per-browser daily cap (default 50). Shared provider quota is the backstop.
# INFERENCE_CLIENT_DAILY_LIMIT=50
