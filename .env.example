# Server-only. Never prefix with VITE_ (that would ship the key to the browser).
# Copy to `.env.local` for local `npx vercel dev` / `npm run dev:vercel`.
# Production: set the same vars in the Vercel project env.
#
# Hosted backup provider: ollama (default) or gemini.
INFERENCE_PROVIDER=ollama
OLLAMA_API_KEY=
GEMINI_API_KEY=

# Reversible shared-service route. Default false retains the direct provider.
# Enable in a controlled preview first; see docs/shared-inference-rollout.md.
# All SHARED_INFERENCE_* settings are backend-only. Never use VITE_ prefixes.
# SHARED_INFERENCE_ENABLED=false
# SHARED_INFERENCE_URL=https://ipa-inference-fallback-api.vercel.app/api/inference
# Local shared service in a separate terminal:
# SHARED_INFERENCE_URL=http://127.0.0.1:3001/api/inference
# SHARED_INFERENCE_APP_SECRET=
# SHARED_INFERENCE_OLLAMA_API_KEY=
# SHARED_INFERENCE_GEMINI_API_KEY=
# Replit is not routed until its app-specific live checks pass.
# SHARED_INFERENCE_REPLIT_API_KEY=
# After validating Gemini search with the selected model, explicitly opt in:
# SHARED_INFERENCE_GEMINI_SEARCH_ENABLED=false

# Independent models let you switch providers without changing model settings.
# gemma4:cloud is translated to gemma4:31b for the direct ollama.com API.
# OLLAMA_INFERENCE_MODEL=gemma4:cloud
# OLLAMA_MODEL is reserved for detect-spam; it does not affect hosted Ask AI.
# GEMINI_MODEL=gemma-4-31b-it
# Legacy Gemini key INFERENCE_API_KEY is still accepted for Gemini only.
# INFERENCE_MODEL is a legacy model override, used only with an explicit
# INFERENCE_PROVIDER and when that provider's own model setting is absent.

# Ollama protection per server process (not shared across Vercel instances).
# Failed attempts, web searches, and chat continuations count toward the limit.
# OLLAMA_REQUESTS_PER_MINUTE=20
# OLLAMA_CLIENT_REQUESTS_PER_MINUTE=5
# OLLAMA_MAX_CONCURRENT=2

# Kill switch without redeploying the client (false/0/off disables /api/inference).
# INFERENCE_FALLBACK_ENABLED=true

# Direct route's per-browser daily cap (default 50, per server process).
# The shared service owns its own quotas/admission; the browser retains its
# existing 50-success daily soft count with either backend route.
# INFERENCE_CLIENT_DAILY_LIMIT=50

# Mac Mini CDN warmer (scripts/trending-cron.sh) — not read by Vercel.
# TRENDING_CRON_BASE_URL=https://your-app.vercel.app
# TRENDING_CRON_HOURS=4,12,24,48
# TRENDING_CRON_INTERVAL_SEC=300
# Preview-only: Vercel → Project → Deployment Protection → Protection Bypass for Automation
# TRENDING_CRON_BYPASS_SECRET=

# Same value on Vercel + Mac Mini. Optional. Forces Runtime Cache rebuild on warm.
# TRENDING_WARM_SECRET=

# Local Ollama for `npm run detect-spam` (also read from .env.local by the script).
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=clef-flash
